# ==============================================================================
# KAIROS PWA — VARIABLES DE ENTORNO OFICIALES (PRODUCCIÓN & DESARROLLO)
# ==============================================================================

# 1. BASE DE DATOS EN LA NUBE (SUPABASE)
# Obtén estas credenciales en: https://app.supabase.com -> Project Settings -> API
SUPABASE_URL=https://tu-proyecto.supabase.co
# Recomendado para servidor: Service Role Key (bypasea RLS de forma segura en Next.js Server Components / API)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Clave anónima pública alternativa si no usas Service Role
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 2. SEGURIDAD DE SESIÓN (HMAC-SHA256)
# Clave criptográfica aleatoria de al menos 32 caracteres para firmar los tokens de sesión
SESSION_SECRET=generar_cadena_secreta_super_segura_kairos_2026_minimo_32_caracteres

# 3. MOTOR DE INTELIGENCIA ARTIFICIAL (OPCIONAL / ENHANCED)
# Si se provee, la extracción de rutinas desde imágenes y PDFs usará Gemini 2.5 Flash de forma ultrarrápida.
# Si NO se provee, la app utilizará automáticamente el motor neural OCR offline y el generador científico local sin caerse.
GEMINI_API_KEY=AIzaSy...
